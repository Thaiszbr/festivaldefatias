<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Festival de Fatias - Rita Joice</title>
  
  <!-- Google Fonts para Identidade Visual Clássica e Elegante -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            creme: '#FDF6F2',
            blush: '#F6D7D6',
            rosasuave: '#E7A7B1',
            rosaantigo: '#C97F86',
            chocolate: '#5A3B2E',
            wapp: '#25D366',
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'serif'],
            script: ['"Alex Brush"', 'cursive'],
            sans: ['"Montserrat"', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #FDF6F2;
      color: #5A3B2E;
      font-family: 'Montserrat', sans-serif;
      background-image: radial-gradient(#F6D7D6 0.8px, transparent 0.8px);
      background-size: 16px 16px;
    }

    .heart-divider::before, .heart-divider::after {
      content: "";
      flex: 1;
      border-bottom: 1px solid #E7A7B1;
      margin: auto;
    }

    .border-dashed-custom {
      background-image: url("data:image/svg+xml,%3csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3e%3crect width='100%25' height='100%25' fill='none' rx='16' ry='16' stroke='%23C97F86' stroke-width='2' stroke-dasharray='8%2c 8' stroke-dashoffset='0' stroke-linecap='square'/%3e%3c/svg%3e");
      border-radius: 16px;
    }

    .btn-shadow {
      box-shadow: 0 4px 14px rgba(201, 127, 134, 0.35);
    }

    .btn-wapp-shadow {
      box-shadow: 0 4px 18px rgba(37, 211, 102, 0.4);
    }

    /* Modal Animation */
    .modal-backdrop {
      transition: opacity 0.25s ease-in-out;
    }
    .modal-content {
      transition: transform 0.25s ease-in-out;
    }
  </style>
</head>
<body class="min-h-screen pb-24 antialiased">

  <!-- Header Principal -->
  <header class="pt-8 pb-6 px-4 text-center max-w-lg mx-auto">
    <!-- Logotipo / Ilustração -->
    <div class="inline-block relative mb-2">
      <div class="w-20 h-20 mx-auto bg-white rounded-full p-2 shadow-sm border border-blush flex items-center justify-center">
        <!-- SVG Fatia de Bolo Elegante e Minimalista -->
        <svg viewBox="0 0 100 100" class="w-12 h-12 fill-none stroke-chocolate stroke-[2.2]" stroke-linecap="round" stroke-linejoin="round">
          <!-- Camadas da Fatia -->
          <path d="M 18 68 L 82 68 L 82 56 L 18 56 Z" fill="#F6D7D6" stroke-width="1.8"/>
          <path d="M 18 56 L 82 56 L 82 44 L 18 44 Z" fill="#FDF6F2" stroke-width="1.8"/>
          <path d="M 18 44 L 82 44 L 82 32 L 18 32 Z" fill="#F6D7D6" stroke-width="1.8"/>
          <!-- Topo Angular do Bolo -->
          <path d="M 18 32 L 50 18 L 82 32 Z" fill="#E7A7B1" stroke-width="1.8"/>
          <!-- Detalhe da Cobertura Escorrendo -->
          <path d="M 18 32 C 24 37, 28 32, 34 36 C 40 40, 46 33, 52 37 C 58 41, 64 34, 70 36 C 76 38, 80 32, 82 32" stroke="#C97F86" stroke-width="2"/>
          <!-- Frutinha/Coração de Decoração -->
          <path d="M 50 18 C 47 11, 40 16, 50 23 C 60 16, 53 11, 50 18 Z" fill="#C97F86" stroke="#5A3B2E" stroke-width="1"/>
        </svg>
      </div>
    </div>

    <!-- Títulos da Logo -->
    <h1 class="font-serif text-3xl md:text-4xl font-bold tracking-wide text-chocolate uppercase">
      Festival <span class="text-xs font-sans tracking-widest text-rosaantigo block -my-1">DE</span> Fatias
    </h1>
    <div class="font-script text-3xl text-rosaantigo -mt-1 mb-1">Rita Joice</div>
    <p class="text-xs tracking-wider uppercase text-chocolate/70 font-medium">Bolos & Doces para Eventos</p>

    <!-- Divisória Elegante -->
    <div class="flex items-center justify-center my-4 heart-divider text-rosaantigo px-8">
      <span class="px-3 text-xs tracking-widest uppercase text-rosaantigo font-semibold">Exclusivo</span>
    </div>
  </header>

  <main class="max-w-lg mx-auto px-4 space-y-6">

    <!-- Card de Oferta de Pré-Venda -->
    <section class="bg-gradient-to-b from-white to-creme rounded-2xl p-5 sm:p-6 text-center border-2 border-rosaantigo/30 shadow-md relative overflow-hidden">
      <div class="absolute -top-10 -right-10 w-28 h-28 bg-blush/40 rounded-full blur-xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -left-10 w-28 h-28 bg-rosaantigo/10 rounded-full blur-xl pointer-events-none"></div>
      
      <span class="inline-block bg-rosaantigo text-white text-[11px] font-bold px-3.5 py-1 rounded-full uppercase tracking-wider mb-2 shadow-sm">
        Oferta Exclusiva de Pré-Venda
      </span>

      <!-- Título com text-balance para evitar palavra isolada -->
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-chocolate mb-1 leading-snug text-balance">
        Sua fatia favorita com preço especial!
      </h2>

      <!-- Preço De / Por com o aviso 'Somente na Pré-venda' integrado ao valor -->
      <div class="my-4 flex flex-col items-center justify-center gap-2 max-w-xs mx-auto">
        <div class="bg-white/90 px-4 py-1 rounded-full border border-blush shadow-xs">
          <span class="text-xs font-semibold text-chocolate/60 mr-1">DE</span>
          <span class="text-base line-through text-rosaantigo font-serif font-bold">R$ 22,00</span>
        </div>
        
        <div class="bg-rosaantigo text-white px-5 py-3 rounded-2xl shadow-lg w-full flex flex-col items-center justify-center gap-1">
          <div class="flex items-center justify-center gap-2">
            <span class="text-xs font-bold uppercase tracking-widest opacity-90">POR</span>
            <span class="font-serif text-3xl sm:text-4xl font-bold tracking-tight">R$ 20,00</span>
          </div>
          <!-- Badge reposicionado logo abaixo do R$ 20,00 -->
          <span class="text-[10px] font-bold uppercase tracking-wider bg-white/20 text-white px-3 py-0.5 rounded-full">
            ♡ Somente na Pré-Venda ♡
          </span>
        </div>
      </div>

      <!-- Contador de Término da Pré-venda -->
      <div class="mt-4 pt-4 border-t border-blush/50">
        <p class="text-xs text-chocolate/70 font-medium mb-2 flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5 stroke-rosaantigo fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          A pré-venda encerra dia <b>12 de novembro às 19h00</b>:
        </p>
        <div class="grid grid-cols-4 gap-2 text-center" id="countdown-container">
          <div class="bg-creme p-2 rounded-xl border border-blush">
            <span id="timer-days" class="font-serif text-xl font-bold text-rosaantigo block">00</span>
            <span class="text-[10px] text-chocolate/60 uppercase">Dias</span>
          </div>
          <div class="bg-creme p-2 rounded-xl border border-blush">
            <span id="timer-hours" class="font-serif text-xl font-bold text-rosaantigo block">00</span>
            <span class="text-[10px] text-chocolate/60 uppercase">Horas</span>
          </div>
          <div class="bg-creme p-2 rounded-xl border border-blush">
            <span id="timer-mins" class="font-serif text-xl font-bold text-rosaantigo block">00</span>
            <span class="text-[10px] text-chocolate/60 uppercase">Min</span>
          </div>
          <div class="bg-creme p-2 rounded-xl border border-blush">
            <span id="timer-secs" class="font-serif text-xl font-bold text-rosaantigo block">00</span>
            <span class="text-[10px] text-chocolate/60 uppercase">Seg</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Card de Localização e Data -->
    <section class="bg-white rounded-2xl p-5 border border-blush shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-start gap-3 w-full sm:w-auto">
        <div class="w-10 h-10 rounded-xl bg-blush/40 text-rosaantigo flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 stroke-rosaantigo fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <h3 class="font-serif font-bold text-chocolate text-base">Local do Festival</h3>
          <p class="text-xs text-rosaantigo font-semibold mb-1">15 de Novembro • Das 14h às 19h</p>
          <p class="text-xs text-chocolate/80">Rua 2072, Jardim Nápoles — Sinop</p>
        </div>
      </div>
      <a href="https://maps.app.goo.gl/tEiseqacbNgTD7Nn8" target="_blank" rel="noopener"
         class="w-full sm:w-auto text-center bg-creme text-rosaantigo hover:bg-rosaantigo hover:text-white border border-rosaantigo/40 transition-colors text-xs font-bold py-2.5 px-4 rounded-xl shrink-0">
        Ver no Mapa
      </a>
    </section>

    <!-- Seção Escolha Suas Fatias -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="font-serif text-xl font-bold text-chocolate flex items-center gap-2">
          <span>Escolha suas Fatias</span>
        </h2>
        <span class="text-xs font-bold text-rosaantigo bg-blush/40 px-2.5 py-1 rounded-lg">
          R$ 20,00 / un
        </span>
      </div>
      <p class="text-xs text-chocolate/70">
        Clique no botão para selecionar a fatia e escolher sua cobertura.
      </p>

      <!-- Lista de Sabores das Fatias -->
      <div class="space-y-3" id="slice-flavors-list">
        <!-- Renderizado via JavaScript -->
      </div>
    </section>

    <!-- Card Upsell: Copo da Felicidade -->
    <section class="bg-gradient-to-br from-blush/40 via-white to-blush/20 rounded-2xl p-5 border border-rosaantigo/30 shadow-sm text-center relative">
      <span class="inline-block bg-rosaantigo text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
        Aproveite Também
      </span>
      <h3 class="font-serif text-xl font-bold text-chocolate mb-1">
        Copo da Felicidade
      </h3>
      <p class="text-xs text-chocolate/80 mb-3">
        Camadas generosas e irresistíveis no copo por apenas <b>R$ 25,00</b> cada!
      </p>

      <div class="flex flex-col sm:flex-row gap-2 justify-center">
        <button id="copo-add-btn" onclick="openCopoModal()" class="bg-rosaantigo text-white font-semibold text-xs py-2.5 px-5 rounded-xl btn-shadow hover:bg-chocolate transition-colors flex items-center justify-center gap-1.5">
          Sim! Escolher meu Copo (+ R$ 25,00)
        </button>
      </div>
    </section>

    <!-- Formulário de Recebimento e Dados do Cliente -->
    <section class="bg-white rounded-2xl p-5 border border-blush shadow-sm space-y-4">
      <h3 class="font-serif text-lg font-bold text-chocolate border-b border-blush pb-2 flex items-center gap-2">
        Dados de Recebimento
      </h3>

      <!-- Nome -->
      <div>
        <label class="block text-xs font-semibold text-chocolate/80 mb-1">Seu Nome Completo:</label>
        <input type="text" id="customer-name" placeholder="Digite seu nome..." 
               class="w-full bg-creme border border-blush rounded-xl px-3 py-2 text-xs text-chocolate focus:outline-none focus:border-rosaantigo">
      </div>

      <!-- Opções de Recebimento -->
      <div>
        <label class="block text-xs font-semibold text-chocolate/80 mb-1.5">Como prefere receber seu pedido?</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="border border-blush bg-creme p-3 rounded-xl flex items-start gap-2 cursor-pointer hover:border-rosaantigo transition-colors">
            <input type="radio" name="delivery-method" value="retirada" checked onchange="toggleAddressInput()" class="mt-0.5 accent-rosaantigo">
            <div class="text-xs">
              <span class="font-bold text-chocolate block">Retirada no Evento</span>
              <span class="text-[11px] text-chocolate/70">15/11 (14h às 19h) — Sem Taxa</span>
            </div>
          </label>

          <label class="border border-blush bg-creme p-3 rounded-xl flex items-start gap-2 cursor-pointer hover:border-rosaantigo transition-colors">
            <input type="radio" name="delivery-method" value="entrega" onchange="toggleAddressInput()" class="mt-0.5 accent-rosaantigo">
            <div class="text-xs">
              <span class="font-bold text-chocolate block">Entrega em Casa</span>
              <span class="text-[11px] text-chocolate/70">15/11 Pela manhã</span>
            </div>
          </label>
        </div>
      </div>

      <!-- Seção de Endereço e Busca por CEP (Exibida somente se for Entrega) -->
      <div id="address-container" class="hidden space-y-3 pt-2 border-t border-blush/60">
        <!-- Campo CEP com Busca -->
        <div>
          <label class="block text-xs font-semibold text-chocolate/80 mb-1">CEP (opcional):</label>
          <div class="flex gap-2">
            <input type="text" id="customer-cep" placeholder="78550-000" maxlength="9" 
                   class="w-full bg-creme border border-blush rounded-xl px-3 py-2 text-xs text-chocolate focus:outline-none focus:border-rosaantigo">
            <button type="button" onclick="searchCep()" 
                    class="bg-rosaantigo text-white text-xs font-semibold px-4 py-2 rounded-xl hover:bg-chocolate transition-colors shrink-0">
              Buscar CEP
            </button>
          </div>
          <p id="cep-loading" class="text-[11px] text-rosaantigo font-medium mt-1 hidden">Buscando endereço...</p>
        </div>

        <!-- Endereço Completo -->
        <div>
          <label class="block text-xs font-semibold text-chocolate/80 mb-1">Endereço de Entrega Completo:</label>
          <textarea id="customer-address" rows="2" placeholder="Rua, número, bairro e ponto de referência em Sinop..." 
                    class="w-full bg-creme border border-blush rounded-xl p-2.5 text-xs text-chocolate focus:outline-none focus:border-rosaantigo"></textarea>
        </div>

        <!-- Aviso do Cálculo de Entrega -->
        <div id="delivery-fee-notice" class="bg-blush/30 border border-rosaantigo/30 rounded-xl p-3 text-[11px] text-chocolate/80 leading-relaxed">
          <span class="font-bold text-chocolate">Aviso sobre o frete:</span> O cálculo do valor da entrega é informado no momento do pagamento e confirmação no WhatsApp.
        </div>
      </div>

      <!-- Forma de Pagamento (Atualizado para Pix ou Cartão de Crédito) -->
      <div>
        <label class="block text-xs font-semibold text-chocolate/80 mb-1">Forma de Pagamento Preferida:</label>
        <select id="payment-method" class="w-full bg-creme border border-blush rounded-xl px-3 py-2 text-xs text-chocolate focus:outline-none focus:border-rosaantigo font-medium">
          <option value="Pix">Pix (Chave informada no WhatsApp)</option>
          <option value="Cartão de Crédito">Cartão de Crédito</option>
        </select>
      </div>
    </section>

    <!-- Carrinho / Resumo do Pedido -->
    <section class="bg-white rounded-2xl p-5 border border-blush shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-blush pb-2">
        <h3 class="font-serif text-lg font-bold text-chocolate flex items-center gap-2">
          Resumo do seu Pedido
        </h3>
        <span id="cart-count-badge" class="bg-rosaantigo text-white text-[11px] font-bold px-2 py-0.5 rounded-full">
          0 itens
        </span>
      </div>

      <!-- Lista de Itens do Carrinho -->
      <div id="cart-items-list" class="space-y-2">
        <!-- Renderizado dinamicamente -->
        <p class="text-center text-xs text-chocolate/60 py-4 italic">
          Sua sacola está vazia. Adicione fatias acima para iniciar!
        </p>
      </div>

      <!-- Total da Compra -->
      <div class="pt-3 border-t border-blush flex items-center justify-between">
        <span class="text-xs font-bold text-chocolate/80 uppercase tracking-wider">Total (Pré-venda):</span>
        <span id="cart-total-price" class="font-serif text-2xl font-bold text-rosaantigo">R$ 0,00</span>
      </div>
    </section>

    <!-- Botão Finalizar no WhatsApp -->
    <button onclick="checkoutToWhatsApp()" 
            class="w-full bg-wapp hover:bg-emerald-600 text-white font-bold text-sm py-4 px-6 rounded-2xl btn-wapp-shadow transition-all duration-200 flex items-center justify-center gap-3 active:scale-[0.99]">
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>Garanta sua Pré-Venda no WhatsApp</span>
    </button>

    <!-- Rodapé de Créditos -->
    <footer class="text-center py-4 text-[11px] text-chocolate/60 space-y-1">
      <p class="font-serif text-sm font-bold text-chocolate">Rita Joice | Bolos & Doces para Eventos</p>
      <p>@ritajoicebolosedoces • Sinop - MT</p>
    </footer>

  </main>

  <!-- MODAL: Cobertura da Fatia -->
  <div id="modal-topping" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none modal-backdrop">
    <div class="bg-white rounded-3xl p-6 w-full max-w-sm border border-blush shadow-xl text-center transform scale-95 modal-content space-y-4">
      <div>
        <h3 id="topping-modal-title" class="font-serif text-xl font-bold text-chocolate">
          Escolha a Cobertura
        </h3>
        <p class="text-xs text-chocolate/70 mt-0.5">Personalize sua fatia!</p>
      </div>

      <div class="space-y-2 text-left" id="topping-options-list">
        <!-- Opções de Cobertura -->
        <button onclick="selectTopping('Brigadeiro', this)" 
                class="topping-btn w-full border border-blush bg-creme p-3 rounded-xl text-xs font-semibold text-chocolate flex items-center justify-between hover:border-rosaantigo transition-all">
          <span>Cobertura de Brigadeiro</span>
          <span class="check-mark opacity-0 text-rosaantigo font-bold">✓</span>
        </button>

        <button onclick="selectTopping('Ninho', this)" 
                class="topping-btn w-full border border-blush bg-creme p-3 rounded-xl text-xs font-semibold text-chocolate flex items-center justify-between hover:border-rosaantigo transition-all">
          <span>Cobertura de Ninho</span>
          <span class="check-mark opacity-0 text-rosaantigo font-bold">✓</span>
        </button>

        <button onclick="selectTopping('Mista (Ninho/Chocolate)', this)" 
                class="topping-btn w-full border border-blush bg-creme p-3 rounded-xl text-xs font-semibold text-chocolate flex items-center justify-between hover:border-rosaantigo transition-all">
          <span>Cobertura Mista (Ninho/Chocolate)</span>
          <span class="check-mark opacity-0 text-rosaantigo font-bold">✓</span>
        </button>

        <!-- Divisória Suave -->
        <div class="pt-2 border-t border-blush/60"></div>

        <!-- Opção Sem Cobertura destacada no rodapé em tom neutro -->
        <button onclick="selectTopping('Sem Cobertura', this)" 
                class="topping-btn w-full border-2 border-dashed border-stone-300 bg-stone-50 p-3 rounded-xl text-xs font-semibold text-stone-600 flex items-center justify-between hover:border-stone-400 transition-all">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-stone-400"></span>
            <span>Sem Cobertura <span class="font-normal text-[11px] text-stone-500">(Apenas a Fatia Tradicional)</span></span>
          </div>
          <span class="check-mark opacity-0 text-chocolate font-bold">✓</span>
        </button>
      </div>

      <div class="flex gap-2 pt-2">
        <button onclick="closeToppingModal()" class="w-1/3 bg-creme text-chocolate/70 text-xs font-bold py-3 rounded-xl hover:bg-blush/30">
          Cancelar
        </button>
        <button onclick="confirmSliceAddition()" class="w-2/3 bg-rosaantigo text-white text-xs font-bold py-3 rounded-xl btn-shadow hover:bg-chocolate transition-colors">
          Adicionar Fatia
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL: Copo da Felicidade -->
  <div id="modal-copo" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none modal-backdrop">
    <div class="bg-white rounded-3xl p-6 w-full max-w-sm border border-blush shadow-xl text-center transform scale-95 modal-content space-y-4">
      <div>
        <h3 class="font-serif text-xl font-bold text-chocolate">
          Copo da Felicidade (R$ 25,00)
        </h3>
        <p class="text-xs text-chocolate/70 mt-0.5">Selecione o seu sabor preferido:</p>
      </div>

      <div class="space-y-2 text-left">
        <button onclick="selectCopoOption('Brownie com Morango', this)" 
                class="copo-btn w-full border border-blush bg-creme p-3.5 rounded-xl text-xs font-semibold text-chocolate flex items-center justify-between hover:border-rosaantigo transition-all">
          <div>
            <span class="font-bold block text-chocolate">Brownie com Morango</span>
            <span class="text-[10px] text-chocolate/60">Camadas de brownie, creme e morangos frescos</span>
          </div>
          <span class="copo-check opacity-0 text-rosaantigo font-bold text-sm">✓</span>
        </button>

        <button onclick="selectCopoOption('Duo com Morango', this)" 
                class="copo-btn w-full border border-blush bg-creme p-3.5 rounded-xl text-xs font-semibold text-chocolate flex items-center justify-between hover:border-rosaantigo transition-all">
          <div>
            <span class="font-bold block text-chocolate">Duo com Morango</span>
            <span class="text-[10px] text-chocolate/60">Creme de Ninho, brigadeiro gourmet e morangos</span>
          </div>
          <span class="copo-check opacity-0 text-rosaantigo font-bold text-sm">✓</span>
        </button>
      </div>

      <div class="flex gap-2 pt-2">
        <button onclick="closeCopoModal()" class="w-1/3 bg-creme text-chocolate/70 text-xs font-bold py-3 rounded-xl hover:bg-blush/30">
          Cancelar
        </button>
        <button onclick="confirmCopoAddition()" class="w-2/3 bg-rosaantigo text-white text-xs font-bold py-3 rounded-xl btn-shadow hover:bg-chocolate transition-colors">
          Adicionar Copo
        </button>
      </div>
    </div>
  </div>

  <script>
    // Configurações Globais
    const WHATSAPP_NUMBER = "5566996413664";

    // Sabores das Fatias (Conforme relatório Rita Joice)
    const SLICE_FLAVORS = [
      {
        id: 'pudim',
        name: 'Fatia de Pudim',
        desc: 'Massa de baunilha, uma camada de pudim cremoso e uma camada de doce de leite.',
        price: 20.00
      },
      {
        id: 'ninho-morango',
        name: 'Ninho, Morango e Brigadeiro',
        desc: 'Massa de chocolate, uma camada de brigadeiro com morango e uma de creme de Ninho.',
        price: 20.00
      },
      {
        id: 'red-velvet',
        name: 'Red Velvet',
        desc: 'Massa vermelha aveludada com recheio cremoso de cream cheese e frutas vermelhas.',
        price: 20.00
      },
      {
        id: 'frutas-vermelhas',
        name: 'Frutas Vermelhas',
        desc: 'Massa branca fofinha com brigadeiro branco gourmet e geleia de frutas vermelhas.',
        price: 20.00
      },
      {
        id: 'coco-abacaxi',
        name: 'Coco com Abacaxi',
        desc: 'Massa branca com recheio artesanal de cocada cremosa e pedaços de abacaxi.',
        price: 20.00
      },
      {
        id: 'chocolate',
        name: 'Fatia Chocolatuda',
        desc: 'Massa de chocolate super molhadinha com creme intenso de brigadeiro gourmet.',
        price: 20.00
      }
    ];

    // Estado da Aplicação
    let cart = [];
    let selectedSlice = null;
    let selectedTopping = null;
    let selectedCopoFlavor = null;

    // Função de Busca de CEP via API ViaCEP
    async function searchCep() {
      const cepInput = document.getElementById('customer-cep');
      const cleanCep = cepInput.value.replace(/\D/g, '');
      const loadingEl = document.getElementById('cep-loading');

      if (cleanCep.length !== 8) {
        alert('Por favor, digite um CEP válido contendo 8 números.');
        return;
      }

      loadingEl.classList.remove('hidden');

      try {
        const response = await fetch(`https://viacep.com.br/ws/${cleanCep}/json/`);
        const data = await response.json();

        if (data.erro) {
          alert('CEP não encontrado. Por favor, digite seu endereço manualmente.');
        } else {
          const addressField = document.getElementById('customer-address');
          let formattedAddress = `${data.logradouro}`;
          if (data.bairro) formattedAddress += `, Bairro ${data.bairro}`;
          formattedAddress += ` - ${data.localidade}/${data.uf}`;
          
          addressField.value = formattedAddress + ', Nº ';
          addressField.focus();
        }
      } catch (err) {
        alert('Não foi possível buscar o CEP automaticamente. Digite seu endereço no campo abaixo.');
      } finally {
        loadingEl.classList.add('hidden');
      }
    }

    // Atualiza o texto do botão do Copo da Felicidade dependendo se já foi adicionado algum
    function updateCopoButtonText() {
      const hasCopo = cart.some(item => item.type === 'copo');
      const copoBtn = document.getElementById('copo-add-btn');
      
      if (hasCopo) {
        copoBtn.innerText = 'Deseja adicionar mais um copo? (+ R$ 25,00)';
      } else {
        copoBtn.innerText = 'Sim! Escolher meu Copo (+ R$ 25,00)';
      }
    }

    // Timer Regressivo até 12 de Novembro às 19:00
    function startCountdown() {
      const targetDate = new Date('2026-11-12T19:00:00');

      function update() {
        const now = new Date();
        const diff = targetDate - now;

        if (diff <= 0) {
          document.getElementById('countdown-container').innerHTML = `
            <div class="col-span-4 bg-rosaantigo/10 text-rosaantigo p-3 rounded-xl font-bold text-xs">
              Pré-venda encerrada! Vendas presenciais no dia do festival.
            </div>
          `;
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secs = Math.floor((diff % (1000 * 60)) / 1000);

        document.getElementById('timer-days').innerText = String(days).padStart(2, '0');
        document.getElementById('timer-hours').innerText = String(hours).padStart(2, '0');
        document.getElementById('timer-mins').innerText = String(mins).padStart(2, '0');
        document.getElementById('timer-secs').innerText = String(secs).padStart(2, '0');
      }

      update();
      setInterval(update, 1000);
    }

    function renderFlavors() {
      const container = document.getElementById('slice-flavors-list');
      container.innerHTML = SLICE_FLAVORS.map(flavor => `
        <div class="bg-white rounded-2xl p-4 border border-blush shadow-sm flex flex-col justify-between gap-3 hover:border-rosaantigo/50 transition-colors">
          <div>
            <div class="flex justify-between items-start mb-1">
              <h3 class="font-serif font-bold text-chocolate text-base">${flavor.name}</h3>
              <span class="text-xs font-bold text-rosaantigo whitespace-nowrap ml-2">R$ 20,00</span>
            </div>
            <p class="text-xs text-chocolate/70 leading-relaxed">${flavor.desc}</p>
          </div>
          
          <button onclick="openToppingModal('${flavor.id}')" 
                  class="w-full bg-creme hover:bg-rosaantigo hover:text-white text-rosaantigo font-bold text-xs py-2.5 px-4 rounded-xl border border-rosaantigo/30 transition-all flex items-center justify-center gap-1.5">
            + Escolher Cobertura
          </button>
        </div>
      `).join('');
    }

    function openToppingModal(sliceId) {
      selectedSlice = SLICE_FLAVORS.find(s => s.id === sliceId);
      selectedTopping = null;
      
      document.getElementById('topping-modal-title').innerText = `Cobertura para: ${selectedSlice.name}`;
      
      document.querySelectorAll('.topping-btn').forEach(btn => {
        btn.classList.remove('border-rosaantigo', 'bg-blush/30');
        btn.querySelector('.check-mark').classList.add('opacity-0');
      });

      const modal = document.getElementById('modal-topping');
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.querySelector('.modal-content').classList.remove('scale-95');
    }

    function selectTopping(toppingName, btnElement) {
      selectedTopping = toppingName;
      
      document.querySelectorAll('.topping-btn').forEach(btn => {
        btn.classList.remove('border-rosaantigo', 'bg-blush/30');
        btn.querySelector('.check-mark').classList.add('opacity-0');
      });

      btnElement.classList.add('border-rosaantigo', 'bg-blush/30');
      btnElement.querySelector('.check-mark').classList.remove('opacity-0');
    }

    function closeToppingModal() {
      const modal = document.getElementById('modal-topping');
      modal.classList.add('pointer-events-none', 'opacity-0');
      modal.querySelector('.modal-content').classList.add('scale-95');
    }

    function confirmSliceAddition() {
      if (!selectedTopping) {
        alert('Por favor, escolha uma opção de cobertura para a sua fatia!');
        return;
      }

      cart.push({
        type: 'fatia',
        title: selectedSlice.name,
        detail: `Cobertura: ${selectedTopping}`,
        price: 20.00
      });

      closeToppingModal();
      renderCart();
    }

    function openCopoModal() {
      selectedCopoFlavor = null;
      
      document.querySelectorAll('.copo-btn').forEach(btn => {
        btn.classList.remove('border-rosaantigo', 'bg-blush/30');
        btn.querySelector('.copo-check').classList.add('opacity-0');
      });

      const modal = document.getElementById('modal-copo');
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.querySelector('.modal-content').classList.remove('scale-95');
    }

    function selectCopoOption(flavorName, btnElement) {
      selectedCopoFlavor = flavorName;

      document.querySelectorAll('.copo-btn').forEach(btn => {
        btn.classList.remove('border-rosaantigo', 'bg-blush/30');
        btn.querySelector('.copo-check').classList.add('opacity-0');
      });

      btnElement.classList.add('border-rosaantigo', 'bg-blush/30');
      btnElement.querySelector('.copo-check').classList.remove('opacity-0');
    }

    function closeCopoModal() {
      const modal = document.getElementById('modal-copo');
      modal.classList.add('pointer-events-none', 'opacity-0');
      modal.querySelector('.modal-content').classList.add('scale-95');
    }

    function confirmCopoAddition() {
      if (!selectedCopoFlavor) {
        alert('Por favor, selecione o sabor do seu Copo da Felicidade!');
        return;
      }

      cart.push({
        type: 'copo',
        title: 'Copo da Felicidade',
        detail: `Sabor: ${selectedCopoFlavor}`,
        price: 25.00
      });

      closeCopoModal();
      renderCart();
    }

    function removeFromCart(index) {
      cart.splice(index, 1);
      renderCart();
    }

    function renderCart() {
      const container = document.getElementById('cart-items-list');
      const totalElement = document.getElementById('cart-total-price');
      const badgeElement = document.getElementById('cart-count-badge');

      badgeElement.innerText = `${cart.length} ${cart.length === 1 ? 'item' : 'itens'}`;

      if (cart.length === 0) {
        container.innerHTML = `
          <p class="text-center text-xs text-chocolate/60 py-4 italic">
            Sua sacola está vazia. Adicione fatias acima para iniciar!
          </p>
        `;
        totalElement.innerText = 'R$ 0,00';
        updateCopoButtonText();
        return;
      }

      let total = 0;
      container.innerHTML = cart.map((item, index) => {
        total += item.price;
        return `
          <div class="bg-creme p-3 rounded-xl border border-blush flex items-center justify-between gap-2">
            <div class="text-xs">
              <span class="font-bold text-chocolate block">${item.title}</span>
              <span class="text-[11px] text-chocolate/70">${item.detail}</span>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-xs font-bold text-rosaantigo">R$ ${item.price.toFixed(2).replace('.', ',')}</span>
              <button onclick="removeFromCart(${index})" class="text-xs text-rose-500 font-bold hover:underline px-1">
                ✕
              </button>
            </div>
          </div>
        `;
      }).join('');

      totalElement.innerText = `R$ ${total.toFixed(2).replace('.', ',')}`;
      updateCopoButtonText();
    }

    function toggleAddressInput() {
      const isDelivery = document.querySelector('input[name="delivery-method"]:checked').value === 'entrega';
      const addressContainer = document.getElementById('address-container');
      if (isDelivery) {
        addressContainer.classList.remove('hidden');
      } else {
        addressContainer.classList.add('hidden');
      }
    }

    function checkoutToWhatsApp() {
      const customerName = document.getElementById('customer-name').value.trim();
      const deliveryMethod = document.querySelector('input[name="delivery-method"]:checked').value;
      const customerCep = document.getElementById('customer-cep').value.trim();
      const customerAddress = document.getElementById('customer-address').value.trim();
      const paymentMethod = document.getElementById('payment-method').value;

      if (cart.length === 0) {
        alert('Por favor, adicione pelo menos uma fatia de bolo para realizar a pré-venda!');
        return;
      }

      if (!customerName) {
        alert('Por favor, preencha o seu Nome Completo.');
        document.getElementById('customer-name').focus();
        return;
      }

      if (deliveryMethod === 'entrega' && !customerAddress) {
        alert('Por favor, informe seu endereço completo de entrega.');
        document.getElementById('customer-address').focus();
        return;
      }

      let total = cart.reduce((sum, item) => sum + item.price, 0);

      // Formatação da mensagem para o WhatsApp sem emojis excessivos
      let msg = `*PRÉ-VENDA - FESTIVAL DE FATIAS RITA JOICE*\n`;
      msg += `=============================\n\n`;
      msg += `*Cliente:* ${customerName}\n`;
      msg += `*Forma de Pagamento:* ${paymentMethod}\n`;
      
      if (deliveryMethod === 'retirada') {
        msg += `*Recebimento:* Retirada no Evento (15/11, 14h às 19h)\n`;
      } else {
        msg += `*Recebimento:* Entrega em Casa (15/11 Pela Manhã)\n`;
        if (customerCep) msg += `*CEP:* ${customerCep}\n`;
        msg += `*Endereço:* ${customerAddress}\n`;
        msg += `*(Valor da taxa de entrega a ser confirmado no atendimento)*\n`;
      }

      msg += `\n*ITENS SELECIONADOS:*\n`;
      cart.forEach((item, idx) => {
        msg += `${idx + 1}. *${item.title}* (R$ ${item.price.toFixed(2).replace('.', ',')})\n`;
        msg += `   └ ${item.detail}\n`;
      });

      msg += `\n*TOTAL DA PRÉ-VENDA:* R$ ${total.toFixed(2).replace('.', ',')}\n`;
      msg += `=============================\n`;
      msg += `*Local do Evento:* Rua 2072, Jardim Nápoles, Sinop-MT\n`;

      const encodedMsg = encodeURIComponent(msg);
      const wappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMsg}`;

      window.open(wappUrl, '_blank');
    }

    // Inicialização da página
    window.onload = function() {
      renderFlavors();
      startCountdown();
    };
  </script>
</body>
</html>
